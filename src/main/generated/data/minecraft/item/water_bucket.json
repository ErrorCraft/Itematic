{
  "behavior": {
    "minecraft:bucket": {
      "modification": {
        "type": "minecraft:place_fluid",
        "fluid": "minecraft:water",
        "place_sound": "minecraft:item.bucket.empty",
        "transforms_into": "minecraft:bucket"
      }
    },
    "minecraft:dispensable": {
      "behavior": "minecraft:use_bucket"
    },
    "minecraft:stackable": 1
  },
  "display": {
    "model": "minecraft:water_bucket",
    "translation_key": "item.minecraft.water_bucket"
  },
  "events": {
    "minecraft:before_use_on_block": {
      "cancel_original_call_on_success": true,
      "entry": {
        "action": {
          "type": "minecraft:sequence",
          "handler": "minecraft:passing",
          "entries": [
            {
              "action": {
                "type": "minecraft:exchange_item",
                "item": {
                  "id": "minecraft:bucket"
                }
              }
            },
            {
              "action": {
                "type": "minecraft:increment_stat",
                "entity": "this",
                "stat": {
                  "type": "minecraft:custom",
                  "entry": "minecraft:fill_cauldron"
                }
              }
            },
            {
              "action": {
                "type": "minecraft:increment_stat",
                "entity": "this",
                "stat": {
                  "type": "minecraft:used",
                  "entry": "minecraft:water_bucket"
                }
              }
            },
            {
              "action": {
                "type": "minecraft:set_block_state",
                "position": "interacted",
                "state": {
                  "Name": "minecraft:water_cauldron",
                  "Properties": {
                    "level": "3"
                  }
                }
              }
            },
            {
              "action": {
                "type": "minecraft:play_sound",
                "category": "block",
                "pitch": 1.0,
                "position": "interacted",
                "sound": "minecraft:item.bucket.empty",
                "volume": 1.0
              }
            },
            {
              "action": {
                "type": "minecraft:invoke_game_event",
                "event": "minecraft:fluid_place",
                "position": "interacted"
              }
            },
            {
              "action": {
                "type": "minecraft:swing_hand",
                "entity": "this"
              }
            }
          ]
        },
        "requirements": {
          "condition": "minecraft:location_check",
          "position": "interacted",
          "predicate": {
            "block": {
              "blocks": "#minecraft:cauldrons"
            }
          }
        }
      }
    }
  }
}