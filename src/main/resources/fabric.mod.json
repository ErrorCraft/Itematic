{
  "schemaVersion": 1,
  "id": "itematic",
  "version": "${version}",
  "name": "Itematic",
  "description": "A mod that adds data-driven items to Minecraft.",
  "authors": [
    "ErrorCraft"
  ],
  "contact": {
    "homepage": "https://itematic.errorcraft.net",
    "issues": "https://github.com/ErrorCraft/Itematic/issues",
    "sources": "https://github.com/ErrorCraft/Itematic"
  },
  "license": "Apache-2.0",
  "icon": "assets/itematic/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.errorcraft.itematic.Itematic"
    ],
    "fabric-datagen": [
      "net.errorcraft.itematic.data.ItematicData"
    ]
  },
  "mixins": [
    "itematic.mixins.json",
    {
      "config": "itematic.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "itematic.classtweaker",
  "depends": {
    "fabricloader": ">=0.19.2",
    "fabric-api": "*",
    "minecraft": "~1.21-",
    "java": ">=21"
  }
}
